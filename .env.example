# Copy this file to `.env` and fill in real values before `make up`.
# `.env` is gitignored — it must never be committed. Only this example file
# is tracked.

# --------------------------------------------------------------------------
# Required — no safe default exists for either.
# --------------------------------------------------------------------------

# The public domain this stack is served on. Must already have a DNS A
# record pointing at this server's IP before `make up`, or Let's Encrypt's
# HTTP-01 challenge will fail.
DOMAIN=demo.example.com

# Contact address Let's Encrypt uses for expiry notices and, rarely, abuse
# notices. Not otherwise public.
ACME_EMAIL=ops@example.com

# --------------------------------------------------------------------------
# Optional — traefik
# --------------------------------------------------------------------------

# Traefik's own log verbosity (DEBUG, INFO, WARN, ERROR).
TRAEFIK_LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Optional — traffic_ai settings (see src/traffic_ai/config.py:Settings for
# the full list; these are the ones that matter operationally).
# --------------------------------------------------------------------------

# Structured log verbosity for the ui and worker services.
TRAFFIC_AI_LOG_LEVEL=INFO

# `json` for log aggregation, `console` for a human-readable local run.
TRAFFIC_AI_LOG_FORMAT=json

# Frames actually processed per second, per camera. The main lever for CPU
# load — lower it first if the worker falls behind on a small server.
TRAFFIC_AI_TARGET_FPS=12

# Run YOLO detection every Nth frame; the tracker interpolates in between.
# Raising this trades a little accuracy for a lot less CPU.
TRAFFIC_AI_DETECT_EVERY_N_FRAMES=2

# Frame width (px) detection runs on, after downscaling. Smaller is faster.
TRAFFIC_AI_FRAME_WIDTH=960

# Ultralytics model weights: a bundled name ("yolov8n.pt") or a path under
# the worker's model-weights volume. Downloaded once and cached there.
TRAFFIC_AI_MODEL_WEIGHTS=/app/weights/yolov8n.pt

# Inference device. This deployment ships CPU-only torch (see
# docker/Dockerfile.worker); do not set this to a CUDA device here.
TRAFFIC_AI_DEVICE=cpu
