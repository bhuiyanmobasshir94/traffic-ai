# Build context hygiene. Both docker/Dockerfile.ui and docker/Dockerfile.worker
# build from the repo root, so anything not needed inside an image — and
# anything that would bloat the context sent to the daemon — is excluded here.

.git
.gitignore
.venv
venv/
# `**/` so nested caches are excluded too: both Dockerfiles COPY `src` (and the
# worker COPYs `migrations`) as whole directories, and a bare `__pycache__/`
# only matches at the context root — stale host bytecode would ride along.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

.claude
.github

tests/
docs/

# Helm chart and other deploy-time material: consumed by the cluster, never
# by an image. NOT excluded on purpose: uv.lock (both Dockerfiles install from
# it), pyproject.toml, README.md (read by the build backend), src/,
# migrations/ and alembic.ini (worker image).
deploy/

# Demo footage: fetched by scripts/fetch_demo_videos.py, mounted read-only
# into the worker container at runtime — never baked into an image.
data/videos/*.mp4

# Local-only / secret material — never sent to the build daemon.
.env
.env.*
!.env.example
.streamlit/secrets.toml
letsencrypt/

*.md
!README.md
