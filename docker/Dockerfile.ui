# syntax=docker/dockerfile:1
#
# UI image — the Streamlit dashboard only. Installs the `ui` extra exclusively
# (see pyproject.toml [project.optional-dependencies]) exactly as pinned in
# uv.lock; it must never pull in torch, ultralytics, or opencv. That split is
# the entire point of the extras — keep it that way. The import check at the
# end of the builder stage enforces it at build time.

ARG UV_VERSION=0.11.25
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.12-slim-bookworm AS builder

COPY --from=uv /uv /bin/uv

# UV_PYTHON_DOWNLOADS=never: the venv must be built on this image's interpreter,
# because the runtime stage copies /opt/venv across and its symlinks must
# resolve to the same /usr/local/bin/python there.
# UV_LINK_MODE=copy: the cache mount below is a different filesystem from
# /opt/venv, so uv cannot hardlink out of it.
ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /build

# --- dependency layer -------------------------------------------------
# --no-install-project installs only the `ui` extra's third-party dependencies,
# so this layer depends on pyproject.toml and uv.lock alone and is invalidated
# only when one of them changes — never by a source edit. (This replaces the
# old stub-package trick; uv needs no stub because it does not build the
# project here.) --locked fails the build if uv.lock no longer matches
# pyproject.toml.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --extra ui

# --- source layer -------------------------------------------------------
# Real source goes in afterwards. --no-editable installs a built wheel into
# the venv, so the runtime stage does not need /build. The extras flag must
# match the layer above or uv would prune what that layer installed.
# README.md is read by the build backend (pyproject `readme`).
COPY README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --extra ui

ENV PATH="/opt/venv/bin:${PATH}"

# Fail the build if the inference stack leaked into the UI image.
RUN python -c "import importlib.util as u, sys; \
leaked = [m for m in ('torch', 'torchvision', 'ultralytics', 'cv2') if u.find_spec(m)]; \
sys.exit('inference stack in UI image: ' + ', '.join(leaked)) if leaked else None"

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --home-dir /app \
        --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=app:app Toll_Booth.py ./
COPY --chown=app:app pages ./pages
COPY --chown=app:app logo.png ./
COPY --chown=app:app .streamlit ./.streamlit

USER app

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request as u,sys; sys.exit(0 if u.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3).status == 200 else 1)"

ENTRYPOINT ["streamlit", "run", "Toll_Booth.py", \
    "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
