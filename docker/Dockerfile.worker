# syntax=docker/dockerfile:1
#
# Worker image — the inference API. Installs the `worker` extra plus a
# CPU-only torch build. ultralytics depends on torch transitively; without
# installing torch first from the CPU wheel index, pip resolves the default
# CUDA-enabled build, which is roughly 2.5GB larger than this deployment
# (CPU-only inference) ever needs.

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# --- dependency layer -------------------------------------------------
# Same stub-package trick as the UI image (see docker/Dockerfile.ui) so the
# dependency install is a separate, source-independent layer. Torch goes in
# first, from the CPU wheel index, so when pip later resolves ultralytics'
# own torch requirement it is already satisfied and never reaches for the
# CUDA build from the default index.
COPY pyproject.toml README.md ./
RUN mkdir -p src/traffic_ai \
    && touch src/traffic_ai/__init__.py \
    && pip install --upgrade pip \
    && pip install --extra-index-url https://download.pytorch.org/whl/cpu torch \
    && pip install ".[worker]"

# --- source layer -------------------------------------------------------
COPY src ./src
RUN pip install --no-deps --force-reinstall .

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

# opencv-python-headless ships no GUI bindings but still dynamically links
# libGL/glib at import time; without these the worker crashes on startup.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --home-dir /app \
        --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# Created (and owned) at build time so Docker copies this ownership onto a
# fresh named volume the first time compose.yaml mounts one here — an empty
# volume created by the engine defaults to root:root otherwise, and the
# non-root `app` user could not write downloaded model weights into it.
RUN mkdir -p /app/weights && chown app:app /app/weights

# ultralytics writes a settings file on first import. Its default location is
# under $HOME/.config, which the non-root user cannot create here — it then
# warns and silently falls back to /tmp, losing the file on every restart.
# Point it at the weights volume so it is writable and persists.
ENV YOLO_CONFIG_DIR=/app/weights

USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request as u,sys; sys.exit(0 if u.urlopen('http://127.0.0.1:8000/api/healthz', timeout=3).status == 200 else 1)"

ENTRYPOINT ["python", "-m", "traffic_ai.api"]
