# syntax=docker/dockerfile:1
#
# Worker image — the inference API. Installs the `worker` extra exactly as
# pinned in uv.lock; nothing is resolved at build time.
#
# CPU-only torch: ultralytics depends on torch transitively, and resolving it
# against the default index yields the CUDA-enabled build, roughly 2.5GB larger
# than this deployment (CPU-only inference) ever needs.
#
# torch and torchvision must come from the SAME index. torchvision ships
# compiled ops that ultralytics calls for non-maximum suppression; a
# torchvision resolved from the default index against a CPU-only torch loads
# but fails at inference with:
#     operator torchvision::nms does not exist
# That surfaces only when a detection actually needs NMS, so it passes a
# startup healthcheck and then breaks the pipeline under real footage.
#
# That pairing used to be enforced by install order (torch + torchvision first,
# from the CPU index, in one pip command). It is now enforced by the lockfile:
# pyproject.toml [tool.uv.sources] pins both packages to the PyTorch CPU index,
# and `uv sync --locked` installs only what uv.lock records, so the pair cannot
# drift and a stale lock fails the build instead of resolving something new.
# The import check at the end of the builder stage still runs the real NMS op,
# so the failure above is caught at build time rather than under footage.

ARG UV_VERSION=0.11.25
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.12-slim-bookworm AS builder

COPY --from=uv /uv /bin/uv

# UV_PYTHON_DOWNLOADS=never: the venv must be built on this image's interpreter,
# because the runtime stage copies /opt/venv across and its symlinks must
# resolve to the same /usr/local/bin/python there.
# UV_LINK_MODE=copy: the cache mount below is a different filesystem from
# /opt/venv, so uv cannot hardlink out of it.
ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /build

# --- dependency layer -------------------------------------------------
# --no-install-project installs only third-party dependencies, so this layer
# depends on pyproject.toml and uv.lock alone and is invalidated only when one
# of them changes — never by a source edit. (This replaces the old stub-package
# trick; uv needs no stub because it does not build the project here.)
# --locked fails the build if uv.lock no longer matches pyproject.toml.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --extra worker

# --- source layer -------------------------------------------------------
# Real source goes in afterwards. --no-editable installs a built wheel into
# the venv, so the runtime stage does not need /build. The extras flag must
# match the layer above or uv would prune what that layer installed.
# README.md is read by the build backend (pyproject `readme`).
COPY README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --extra worker

ENV PATH="/opt/venv/bin:${PATH}"

# Fail the build, not the first detection, if the torch/torchvision pairing is
# broken or a CUDA build slipped in. Runs the compiled NMS op for real.
RUN python -c "import torch, torchvision; from torchvision.ops import nms; \
assert torch.version.cuda is None, 'CUDA build of torch installed'; \
keep = nms(torch.tensor([[0., 0., 10., 10.], [1., 1., 11., 11.], [50., 50., 60., 60.]]), \
torch.tensor([0.9, 0.8, 0.7]), 0.5); \
assert keep.tolist() == [0, 2], keep.tolist()"

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

# opencv-python-headless ships no GUI bindings but still dynamically links
# libGL/glib at import time; without these the worker crashes on startup.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --home-dir /app \
        --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# Alembic runs from the working directory: alembic.ini sets script_location =
# migrations and the URL comes from Settings.database_url. Whole directory, so
# new revisions are picked up without touching this file. Deliberately not
# guarded — if either path is missing the build fails, rather than shipping an
# image that cannot migrate its own database.
COPY --chown=app:app alembic.ini ./
COPY --chown=app:app migrations ./migrations

# Created (and owned) at build time so Docker copies this ownership onto a
# fresh named volume the first time compose.yaml mounts one here — an empty
# volume created by the engine defaults to root:root otherwise, and the
# non-root `app` user could not write downloaded model weights into it.
RUN mkdir -p /app/weights && chown app:app /app/weights

# ultralytics writes a settings file on first import. Its default location is
# under $HOME/.config, which the non-root user cannot create here — it then
# warns and silently falls back to /tmp, losing the file on every restart.
# Point it at the weights volume so it is writable and persists.
ENV YOLO_CONFIG_DIR=/app/weights

USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request as u,sys; sys.exit(0 if u.urlopen('http://127.0.0.1:8000/api/healthz', timeout=3).status == 200 else 1)"

ENTRYPOINT ["python", "-m", "traffic_ai.api"]
